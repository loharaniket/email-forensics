# ===================================================================
# Email Forensics - Local Environment Configuration Template
# ===================================================================

# Groq Cloud API Key for Real AI Threat Assessment (Llama 3.3 70B / 3.1 8B)
# Paste your Groq API key below (format: gsk_...)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# AI Provider & Model Options
# Fast, high-accuracy cybersecurity reasoning models:
# - llama-3.3-70b-versatile (Recommended: State-of-the-art fast reasoning)
# - llama-3.1-8b-instant (Fastest, ultra-low latency)
# - mixtral-8x7b-32768 (High context window)
SPRING_AI_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
SPRING_AI_TIMEOUT_SECONDS=25

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=email_forensics
DB_USER=postgres
DB_PASSWORD=

# Application Security & Storage
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
EVIDENCE_VAULT_DIR=./evidence_vault
