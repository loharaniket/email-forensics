# AI Email Forensic Investigation & Threat Correlation
# Local Environment Template

# Server Configuration
SERVER_PORT=8080
FRONTEND_PORT=5173

# Database (Phase 1+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=email_forensics
DB_USER=postgres
DB_PASSWORD=postgres

# Security / JWT (Phase 1+)
JWT_SECRET=replace-with-a-secure-random-256-bit-key-in-production
JWT_EXPIRATION_SECONDS=86400

# Evidence Vault Root (Phase 2+)
EVIDENCE_VAULT_PATH=./evidence_vault

# AI Model Provider (Phase 10+)
SPRING_AI_PROVIDER=openai
SPRING_AI_API_KEY=your_api_key_here
