{
  "git-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|github_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/block-git-commits.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
